				"feats_script": "# King Louis the Stammerer\nfrench_toast = {\nicon = GFX_paris_je_taime_34\nhappened = {\nhas_landed_title = e_france \nhas_landed_title = k_france   \nhas_landed_title = k_aquitaine \n}\n}\nhis_unfulfilled_dream = {\nicon = GFX_turbulent_priest_34\nlevels = { 4 7 10 }\nupdate = {\nset_variable = { which = global_his_unfulfilled_dream value = 0 }\nc_90123 = { # King Louis the Stammerer\nif = {\nlimit = { is_alive = yes }\nany_kill_list_character = {\nif = { \nlimit = { \nOR = { \nreligion = norse_pagan\nreligion = norse_pagan_reformed\n}\n}\nchange_variable = { which = global_his_unfulfilled_dream value = 1 }\n}\n}\nany_kill_list_character = {\nif = { \nlimit = {\nOR = { \nreligion = norse_pagan\nreligion = norse_pagan_reformed\n}\nOR = {\ntrait = viking\ntrait = ravager\ntrait = seaking\ntrait = sea_queen\ntrait = berserker\ntrait = shieldmaiden\ntrait = valhalla_bound\n} \n}\nchange_variable = { which = global_his_unfulfilled_dream value = 1 }\n}\n}\n}\n}\n}\n}\nwhy_dont_you_love_me = {\nicon = GFX_empressive_34\nlevels = { 4 6 8 }\nupdate = {\nset_variable = { which = global_why_dont_you_love_me value = 0 }\nc_90123 = { # King Louis the Stammerer\nif = { \nlimit = { is_alive = yes } \nany_vassal = \n{ \nif = { \nlimit = { \ntier = duke \nopinion = { who = ROOT value = 65 }\n}\nchange_variable = { which = global_why_dont_you_love_me value = 1 }\n}\n}\n}\n}\n}\n}"
